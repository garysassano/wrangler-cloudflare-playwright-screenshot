{
  "name": "wrangler-cloudflare-playwright-screenshot",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm bundle",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.125.0"
  }
}
